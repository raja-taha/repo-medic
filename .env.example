# =============================================================================
# RepoMedic — Environment Configuration
# Copy to .env and fill in values before running docker compose / local services.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=RepoMedic
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Web (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_PORT=3000

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=repomedic
POSTGRES_PASSWORD=repomedic_dev_password
POSTGRES_DB=repomedic
DATABASE_URL=postgresql+asyncpg://repomedic:repomedic_dev_password@localhost:5432/repomedic
DATABASE_URL_SYNC=postgresql://repomedic:repomedic_dev_password@localhost:5432/repomedic

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=repomedic-tasks

# --- OpenAI / LLM ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Optional: Anthropic fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- GitHub ---
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# --- Sandbox (Docker) ---
SANDBOX_ENABLED=true
SANDBOX_IMAGE=repomedic-sandbox:latest
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_CPU_LIMIT=1.0
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_NETWORK_DISABLED=true
WORKSPACE_ROOT=./workspaces

# --- Agent limits ---
MAX_PATCH_ATTEMPTS=3
MAX_FILES_CHANGED=15
MAX_DIFF_BYTES=200000
AGENT_STEP_TIMEOUT_SECONDS=300

# --- Feature flags ---
ALLOW_AUTO_PR=false
SYNTHETIC_MODE=false